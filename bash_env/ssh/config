###=====================================================================================###
#
# OpenSSH configuration example (macOS / Linux)
# Copy to ~/.ssh/config and fill in placeholders.
# https://www.ssh.com/academy/ssh/config
#
# Notes:
# - Host blocks above Host * inherit/override; put specific hosts first.
# - Wildcard Host patterns (labclient*, ws*) share common settings.
# - StrictHostKeyChecking no + empty known_hosts is intentional for ephemeral lab VMs.
#
###=====================================================================================###

###=====================================================================================###
#        Home Lab Aliases
###=====================================================================================###
Host ghost
    HostName <lab-gateway-ip>
    User <local-user>
    ForwardX11 yes
    PasswordAuthentication no

###=====================================================================================###
#        Git Forge Alias (GitLab / GitHub Enterprise style)
###=====================================================================================###
Host git.example.com
    HostName git.example.com
    User git
    IdentityFile ~/.ssh/ed25519_gitlab
    IdentitiesOnly yes

###=====================================================================================###
#        Lab Aliases
###=====================================================================================###

###--- Standard Linux Clients
Host labclient01
    HostName <lab-client-01-ip>

Host labclient02
    HostName <lab-client-02-ip>

Host labclient03
    HostName <lab-client-03-ip>

# Common settings for the labclient* pattern
Host labclient*
    User labuser
    IdentityFile ~/.ssh/admin_keys/labkey
    ForwardX11 yes
    PasswordAuthentication no

###--- Windows SSH Servers
Host ws2019
    HostName <windows-2019-ip>

Host ws2022
    HostName <windows-2022-ip>

Host ws2025
    HostName <windows-2025-ip>

# Common settings for the ws* pattern (includes ControlMaster multiplexing)
Host ws*
    User Administrator
    IdentityFile ~/.ssh/id_ed25519
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 15m
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com

###=====================================================================================###
#        Cloud / AWS aliases using a key file
###=====================================================================================###
Host aws01
    HostName <aws-private-or-public-ip>
    User labuser
    IdentityFile ~/.ssh/admin_keys/cloudkey.pem
    ForwardX11 yes
    PasswordAuthentication no

###=====================================================================================###
#        Optional: SOCKS proxy jump (uncomment and edit)
###=====================================================================================###
# macOS / Linux:
# Host vm-via-socks
#     HostName <target-host>
#     ProxyCommand nc -X 5 -x <socks-proxy-host>:1080 %h %p
#     User <remote-user>
#     PasswordAuthentication no
#
# Windows (nmap ncat):
# Host vm-via-socks
#     HostName <target-host>
#     ProxyCommand "C:\Program Files (x86)\nmap\ncat.exe" --proxy-type socks5 --proxy <socks-proxy-host>:1080 %h %p
#     User <remote-user>
#     PasswordAuthentication no

###=====================================================================================###
#        Common settings for all SSH targets
###=====================================================================================###
Host *
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
    IdentitiesOnly yes
    PKCS11Provider none
    ServerAliveInterval 120
    LogLevel ERROR

# Create the ControlMaster socket directory once:
#   mkdir -p ~/.ssh/sockets && chmod 700 ~/.ssh/sockets
